---
// Страница после отправки формы без JavaScript. Закрыта от индексации.
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
---
<Base title="Заявка отправлена | itis маркетинг" description="Спасибо! Заявка отправлена — свяжемся с вами в течение часа в рабочее время." noindex>
  <section class="section section--ink stack" style="min-height:50vh;justify-content:center">
    <h1 class="h1">Спасибо, заявка отправлена</h1>
    <p class="lead">Свяжемся с вами в течение часа в рабочее время. Если вопрос срочный — напишите в Telegram или позвоните: {site.phone}.</p>
    <div class="actions"><Button href={site.telegram} external>Написать в Telegram</Button><Button href="/keisy/" variant="ghost">Посмотреть кейсы</Button></div>
  </section>
</Base>
