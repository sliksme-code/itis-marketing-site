---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base title="Страница не найдена | itis маркетинг" description="Такой страницы нет." noindex>
  <section class="section section--ink stack" style="min-height:50vh;justify-content:center">
    <h1 class="giant">404</h1>
    <p class="lead">Такой страницы нет. Возможно, она переехала после обновления сайта.</p>
    <div class="actions"><Button href="/">На главную</Button><Button href="/uslugi/" variant="ghost">Услуги</Button></div>
  </section>
</Base>
