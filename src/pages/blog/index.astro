---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LeadForm from '../../components/LeadForm.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts.slice(0, 4);
const order = ['SEO', 'Маркетинг', 'Создание сайта', 'ИИ в маркетинге'];
const cats = [...new Set(posts.map((p) => p.data.category))].sort((a, b) => (order.indexOf(a) + 99) % 99 - (order.indexOf(b) + 99) % 99);
const anchor = (c: string) => ({ 'SEO': 'seo', 'Маркетинг': 'marketing', 'Создание сайта': 'sajty', 'ИИ в маркетинге': 'ii' } as Record<string, string>)[c] ?? 'other';
---
<Base title="Блог itis маркетинг — SEO, реклама, сайты и ИИ в маркетинге" description={`Практические статьи агентства itis маркетинг (${posts.length}): SEO и реклама, маркетинг клиник, школ, бьюти и ИТ, сайты, аналитика и ИИ в маркетинге и продажах.`}>
  <section class="section stack">
    <Breadcrumbs items={[{ href: '/blog/', title: 'Блог' }]} />
    <h1 class="h1">Блог: практика маркетинга</h1>
    <p class="lead">{posts.length} статей о том, как работают каналы, как считать результат и где бизнес теряет клиентов.</p>
    <div class="pills">{cats.map((c) => <a class="pill" href={`#${anchor(c)}`}>{c} · {posts.filter((p) => p.data.category === c).length}</a>)}</div>
  </section>
  <section class="grid grid-2" aria-label="Новые статьи">
    {latest.map((p, i) => (
      <a class:list={['card', i === 0 ? 'card--ink' : '']} href={`/blog/${p.id}/`} style="padding:36px;min-height:240px">
        <span class="card__num">{p.data.category} · {p.data.readingTime} мин</span>
        <h2 class="h3" style="font-size:clamp(22px,2vw,28px)">{p.data.title}</h2>
        <p>{p.data.description}</p>
        <span class="card__more" style="margin-top:auto">Читать →</span>
      </a>
    ))}
  </section>
  {cats.map((c) => (
    <section class="section stack" id={anchor(c)}>
      <h2 class="h2">{c}</h2>
      <ul class="grid grid-3" style="list-style:none;margin:0;padding:0">
        {posts.filter((p) => p.data.category === c).map((p) => (
          <li><a class="card card--mist" href={`/blog/${p.id}/`} style="height:100%"><span class="card__num">{p.data.readingTime} мин</span><h3 class="h3" style="font-size:19px">{p.data.title}</h3></a></li>
        ))}
      </ul>
    </section>
  ))}
  <LeadForm topic="Блог" />
</Base>
