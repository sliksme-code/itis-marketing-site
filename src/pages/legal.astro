---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';
const rows = [
  ['Полное наименование', 'Общество с ограниченной ответственностью «Рост-Решения»'],
  ['Сокращённое наименование', 'ООО «Рост-Решения»'],
  ['ИНН / КПП', '1659157446 / 168501001'],
  ['ОГРН', '1151690022582'],
  ['Юридический адрес', '420044, Республика Татарстан, г. Казань, пр-кт Ибрагимова, д. 39, кв. 27'],
  ['Генеральный директор', 'Галиуллин Марат Рамилевич, действует на основании Устава'],
  ['Расчётный счёт', '40702810662000007998'],
  ['Банк', 'Отделение «Банк Татарстан» № 8610 ПАО Сбербанк, г. Казань'],
  ['БИК / к/с', '049205603 / 30101810600000000603'],
  ['Система налогообложения', 'УСН, НДС 5%'],
  ['ЭДО', 'Контур.Диадок'],
  ['E-mail', site.email],
  ['Телефон', site.phone],
];
---
<Base title="Юридическая информация и реквизиты — ООО «Рост-Решения» | itis" description="Реквизиты ООО «Рост-Решения» (itis маркетинг): ИНН, ОГРН, юридический адрес, банковские реквизиты, электронный документооборот.">
  <section class="section stack">
    <Breadcrumbs items={[{ href: '/legal/', title: 'Юридическая информация' }]} />
    <h1 class="h1">Юридическая информация</h1>
    <p class="lead">Услуги агентства itis маркетинг оказывает ООО «Рост-Решения». Договоры заключаются в письменной форме; закрывающие документы направляются через ЭДО.</p>
  </section>
  <section class="section">
    <div class="table-wrap"><table class="table"><tbody>{rows.map(([k, v]) => <tr><td style="width:34%">{k}</td><td>{v}</td></tr>)}</tbody></table></div>
  </section>
  <section class="section section--mist prose">
    <h2>Документы</h2>
    <p><a href="/privacy-policy/">Политика обработки персональных данных</a></p>
    <p>Карточку компании для договора пришлём по запросу на {site.email}.</p>
  </section>
</Base>
