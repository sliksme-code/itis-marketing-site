---
// Кнопка дизайн-системы: коралловая с тёмным «чипом»-стрелкой, тёмная, контурная.
interface Props { href: string; variant?: 'primary' | 'dark' | 'ghost' | 'light'; size?: 'sm' | 'md'; external?: boolean }
const { href, variant = 'primary', size = 'md', external = false } = Astro.props;
const chip = variant === 'primary' || variant === 'light';
---
<a href={href} class:list={['btn', `btn--${variant}`, size === 'sm' && 'btn--sm']} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
  <span><slot /></span>{chip && <span class="btn__chip" aria-hidden="true"></span>}
</a>
