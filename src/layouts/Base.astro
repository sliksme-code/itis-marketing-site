---
// Базовый шаблон: SEO-теги, Open Graph, canonical, Schema.org Organization,
// шапка, подвал. Всё отдаётся в HTML на этапе сборки.
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { site, mainNav, services, industries, flagship } from '../data/site';
import Button from '../components/Button.astro';
import TelegramIcon from '../components/TelegramIcon.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}
const { title, description, ogImage = '/og-default.png', noindex = false, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;

const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#org`,
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  foundingDate: String(site.founded),
  areaServed: ['RU', ...site.cities],
  address: { '@type': 'PostalAddress', streetAddress: site.office.street, addressLocality: site.office.city, addressRegion: site.office.region, postalCode: site.office.postalCode, addressCountry: 'RU' },
  sameAs: [site.telegram],
  knowsAbout: ['SEO-продвижение', 'Контекстная реклама', 'Разработка сайтов', 'Маркетинговые исследования', 'ИИ в маркетинге'],
};
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, site.url).href} />
  <meta name="theme-color" content="#263238" />
  {site.yandexVerification && <meta name="yandex-verification" content={site.yandexVerification} />}
  {site.googleVerification && <meta name="google-site-verification" content={site.googleVerification} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  {site.metrikaId && (
    <script is:inline define:vars={{ id: site.metrikaId }}>
      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
      ym(Number(id),'init',{ssr:true,clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true,ecommerce:'dataLayer'});
    </script>
  )}
  {site.vkPixel && (
    <script is:inline define:vars={{ vk: site.vkPixel }}>
      !function(){var t=document.createElement("script");t.type="text/javascript",t.async=!0,t.src="https://vk.com/js/api/openapi.js?169",t.onload=function(){VK.Retargeting.Init(vk),VK.Retargeting.Hit()},document.head.appendChild(t)}();
    </script>
  )}
</head>
<body>
  {site.metrikaId && <noscript><div><img src={`https://mc.yandex.ru/watch/${site.metrikaId}`} style="position:absolute; left:-9999px;" alt="" /></div></noscript>}
  {site.vkPixel && <noscript><img src={`https://vk.com/rtrg?p=${site.vkPixel}`} style="position:fixed; left:-999px;" alt="" /></noscript>}
  <a class="skip" href="#main">К содержанию</a>
  <div class="wrap">
    <header class="header">
      <a class="logo" href="/" aria-label="itis маркетинг — на главную"><b>itis—</b><span>маркетинг</span></a>
      <nav class="nav" aria-label="Основное меню">
        {mainNav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) && n.href !== '/' ? 'page' : undefined}>{n.title}</a>)}
      </nav>
      <div class="header__cta">
        <span class="header__phone"><Button href={site.phoneHref} variant="dark" size="sm">{site.phone}</Button></span>
        <a class="icon-btn" href={site.telegram} aria-label="Написать в Telegram" target="_blank" rel="noopener"><TelegramIcon /></a>
        <Button href="#zayavka" size="sm">Рассчитать проект</Button>
        <details class="menu">
          <summary aria-label="Меню"><span></span></summary>
          <nav class="menu__panel" aria-label="Мобильное меню">
            {mainNav.map((n) => <a href={n.href}>{n.title}</a>)}
            <a href={site.phoneHref}>{site.phone}</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main" class="wrap" style="padding:0">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer__top">
        <a class="logo logo--dark" href="/"><b>itis—</b><span>маркетинг</span></a>
        <div class="actions">
          <Button href={site.phoneHref} variant="ghost" size="sm">{site.phone}</Button>
          <Button href={site.telegram} variant="ghost" size="sm" external>Telegram</Button>
          <Button href={`mailto:${site.email}`} variant="ghost" size="sm">{site.email}</Button>
        </div>
      </div>
      <div class="footer__cols">
        <div><h2>Продукты</h2><ul>{flagship.map((s) => <li><a href={s.href}>{s.title}</a></li>)}</ul></div>
        <div><h2>Услуги</h2><ul>{services.map((s) => <li><a href={s.href}>{s.title}</a></li>)}</ul></div>
        <div><h2>Отрасли</h2><ul>{industries.map((s) => <li><a href={s.href}>{s.title}</a></li>)}</ul></div>
        <div><h2>Компания</h2><ul>
          <li><a href="/keisy/">Кейсы</a></li><li><a href="/ceny/">Цены</a></li><li><a href="/blog/">Блог</a></li>
          <li><a href="/o-kompanii/">О компании</a></li><li><a href="/kontakty/">Контакты</a></li>
          <li><a href="/legal/">Юридическая информация</a></li><li><a href="/privacy-policy/">Политика конфиденциальности</a></li>
        </ul></div>
      </div>
      <div class="footer__bottom">
        <span>© {site.founded}–{new Date().getFullYear()} itis маркетинг · {site.legalName}</span>
        <span>{site.cities.join(' · ')} · Головной офис: {site.office.city}, {site.office.street}</span>
      </div>
    </footer>
  </div>
</body>
</html>
